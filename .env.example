# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# Dishost 에 올릴 때는 .env 대신 패널의 환경변수 탭에 넣어도 동일하게 동작합니다.

# ── 필수 ──────────────────────────────────────────────
# Discord Developer Portal > Applications > Bot > Reset Token
DISCORD_TOKEN=

# ── 권장 ──────────────────────────────────────────────
# 없으면 GitHub API 가 시간당 60회로 제한되고, 비공개 저장소는 추적할 수 없습니다.
# github.com > Settings > Developer settings > Personal access tokens
# 필요한 권한: 공개 저장소만 추적하면 권한 없는 토큰으로 충분,
#              비공개 저장소는 해당 저장소의 Contents:Read
GITHUB_TOKEN=

# ── 선택 ──────────────────────────────────────────────
# 개발용 테스트 서버 ID. 넣으면 슬래시 커맨드가 그 서버에 즉시 등록됩니다.
# 비워두면 전역 등록 — 디스코드 반영까지 최대 1시간 걸립니다.
GUILD_ID=

# 폴링 주기(초). 최소 30, 기본 90.
# GitHub 이 X-Poll-Interval 헤더로 더 긴 주기를 요구하면 그쪽을 우선합니다.
POLL_INTERVAL_SECONDS=90

# SQLite 파일이 들어갈 디렉터리 (기본 data)
DATA_DIR=data

# ── AI 요약용 (6단계에서 사용) ────────────────────────
# 서버별로 등록된 AI API 키를 암호화할 마스터 키.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 주의: 이 값을 잃어버리면 등록된 키를 복호화할 수 없어 전부 재등록해야 합니다.
GITCORD_SECRET_KEY=
